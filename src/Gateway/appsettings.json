{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Cars": "http://localhost:8070",
    "Rental": "http://localhost:8060",
    "Payment": "http://localhost:8050",
    "Timeout": "00:00:05"
  },
  "Resilience": {
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "OpenDuration": "00:00:10"
    },
    "RetryQueue": {
      "RetryInterval": "00:00:02",
      "AttemptTimeout": "00:00:10",
      "CompletionWaitTimeout": "00:00:10"
    }
  }
}
